# Copy to .env (git-ignored). Option 1 is easiest and works on any network.
# Option 1: Supabase Data API over HTTPS (run supabase_schema.sql once in the SQL editor first)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Option 2: direct Postgres (session pooler URI from Supabase -> Connect). Leave out if you use option 1.
# DATABASE_URL=postgresql://postgres.<ref>:<password-url-encoded>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
